#!/usr/bin/env bash
# Pre-commit hook: 自动质量检查,阻止不合规代码提交
#
# 安装: cp scripts/git-hooks/pre-commit .git/hooks/ && chmod +x .git/hooks/pre-commit

set -e

echo "🔍 Running pre-commit checks..."

# 1. Formatting check
echo "1/3: Checking code formatting..."
if ! cargo fmt --all --check >/dev/null 2>&1; then
    echo "❌ Code not formatted. Running cargo fmt..."
    cargo fmt --all
    echo "✅ Code formatted. Please review changes and commit again."
    exit 1
fi
echo "✅ Format check passed"

# 2. Clippy check (只检查 staged 文件所属的 crate,避免全量扫描)
echo "2/3: Running clippy..."
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -n "$STAGED_RS_FILES" ]; then
    # 提取受影响的 crate (简化版:检查全工作区)
    if ! cargo clippy --all-targets -- -D warnings 2>&1 | grep -q "Finished"; then
        echo "❌ Clippy warnings found. Fix them with:"
        echo "   cargo clippy --all-targets -- -D warnings"
        exit 1
    fi
fi
echo "✅ Clippy check passed"

# 3. 快速单元测试 (仅 lib tests,集成测试留给 CI)
echo "3/3: Running unit tests..."
if ! cargo test --workspace --lib --quiet 2>&1 | tail -1 | grep -q "test result: ok"; then
    echo "❌ Tests failed. Fix them before committing."
    echo "   cargo test --workspace --lib"
    exit 1
fi
echo "✅ Tests passed"

echo "✨ All pre-commit checks passed!"
