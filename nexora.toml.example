# =============================================================================
# Nexora-RS Configuration File
# =============================================================================
# Copy this file to nexora.toml and customize as needed:
#   cp nexora.toml.example nexora.toml
#
# Configuration priority (highest first):
#   1. CLI arguments  (./nexora-app --port 9090)
#   2. Environment variables  (NEXORA_PORT=9090)
#   3. This TOML file  (nexora.toml)
#   4. Built-in defaults
#
# All sections are optional — Nexora-RS runs with zero configuration.
# =============================================================================


# -----------------------------------------------------------------------------
# [server] — HTTP server settings
# -----------------------------------------------------------------------------
[server]
# Listen address. Use 0.0.0.0 for all interfaces, 127.0.0.1 for localhost only.
host = "0.0.0.0"

# HTTP listen port.
port = 8080

# Maximum request body size in megabytes (prevents memory exhaustion).
request_body_limit_mb = 16


# -----------------------------------------------------------------------------
# [graph] — Graph engine settings
# -----------------------------------------------------------------------------
[graph]
# Number of graph shards. More shards = more parallelism but more overhead.
# Recommended: 128-512 for production. Each shard is an independent actor.
num_shards = 256

# Maximum nodes per shard before LRU eviction kicks in.
# Increase for larger graphs; decrease to reduce memory pressure.
max_nodes_per_shard = 10000

# Tokio channel buffer size per node actor.
# Increase if you see backpressure warnings; decrease to reduce memory.
node_channel_size = 64


# -----------------------------------------------------------------------------
# [storage] — Persistence configuration
# -----------------------------------------------------------------------------
[storage]

# --- RocksDB (durable storage backend) ---
[storage.rocksdb]
# Directory path for RocksDB data files.
path = "./nexora-data"

# Write buffer size (RocksDB memtable). Larger = fewer flushes, more memory.
# Valid formats: "64MB", "128MB", "1GB"
write_buffer_size = "64MB"

# Maximum number of write buffers (memtables) before flushing.
max_write_buffers = 3

# Compression algorithm: "none", "snappy", "lz4", "zstd"
# lz4 = fast compression, good ratio; zstd = best ratio, slower
compression = "lz4"

# --- WAL (Write-Ahead Log for crash recovery) ---
[storage.wal]
# Directory path for WAL files.
dir = "./nexora-data/wal"

# Sync policy (overridable via --wal-sync-policy):
#   "group"   = default; batches one fsync across concurrent writers.
#               Best throughput, and a write is only acked once it is durable.
#   "always"  = fsync every write. Lowest single-write durability latency floor,
#               worst throughput under sustained load.
#   "every_n" = fsync every `sync_interval` records. Fast, but a crash can lose
#               up to the last (sync_interval - 1) writes (NOT durable-on-ack).
#   "never"   = never fsync explicitly; rely on the OS. May lose recent data.
sync_policy = "group"

# Records between fsyncs — a COUNT, not a duration.
# Only used when sync_policy = "every_n".
sync_interval = 1000

# --- S3 (cold storage tier for tiered storage) ---
# Uncomment to enable S3-backed cold storage
# [storage.s3]
# bucket = "my-nexora-bucket"
# region = "us-east-1"
# prefix = "nexora/"
# # Optional: custom endpoint for MinIO or other S3-compatible storage
# # endpoint = "http://localhost:9000"

# --- Iceberg (planned — Apache Iceberg table format integration) ---
# [storage.iceberg]
# catalog_url = "https://my-catalog/api"


# -----------------------------------------------------------------------------
# [cluster] — Distributed cluster configuration
# -----------------------------------------------------------------------------
# Only used when --cluster flag is enabled or profile = "clustered"
[cluster]
# Cluster mode: "peer" (gossip-based) or "raft" (consensus)
mode = "peer"

# This node's unique ID (e.g., "node-1", "node-us-east-1a")
# node_id = "node-1"

# Listen addresses for inter-node communication
# listen = ["0.0.0.0:9080"]  # graph operations
#         ["0.0.0.0:9081"]  # heartbeat

# Seed nodes for cluster discovery (format: "node_id:host:port")
# seeds = ["node-2:10.0.0.2:9080", "node-3:10.0.0.3:9080"]

# Raft consensus port (only if mode = "raft")
# raft_port = 8086


# -----------------------------------------------------------------------------
# [ingest] — Data ingestion sources
# -----------------------------------------------------------------------------
# [[ingest.sources]]
# type = "kafka"
# brokers = "localhost:9092"
# topic = "events"
# group_id = "nexora-consumer"

# [[ingest.sources]]
# type = "file"
# path = "./data/nodes.jsonl"
# format = "jsonl"


# -----------------------------------------------------------------------------
# [logging] — Log output configuration
# -----------------------------------------------------------------------------
[logging]
# Log level: "error", "warn", "info", "debug", "trace"
# Can also be set per-crate: "info,nexora_core=debug,nexora_app=trace"
level = "info"

# Log format: "text" (human-readable) or "json" (structured, for ELK/Loki)
format = "text"


# -----------------------------------------------------------------------------
# [metrics] — Prometheus metrics
# -----------------------------------------------------------------------------
[metrics]
# Enable Prometheus metrics endpoint at /metrics
enabled = true


# -----------------------------------------------------------------------------
# [event_streaming] — Event Streaming Engine (optional)
# -----------------------------------------------------------------------------
# The event streaming engine provides SQL-based stream processing: continuous
# queries, incremental materialized views, and stream joins/aggregations over
# event streams. It is backed by an embedded RisingWave engine.
#
# Requires: --features event-streaming
# Embedded mode requires: --features embedded
# Library mode requires: --features library
# -----------------------------------------------------------------------------
# [event_streaming]
# # Enable the event streaming engine
# enabled = false
#
# # Enable embedded mode (starts the engine as a subprocess)
# # When true, Nexora automatically starts and manages the engine lifecycle
# # When false, connect to an external engine service
# embedded = false
#
# # Meta node address (used in both embedded and external modes)
# meta_addr = "127.0.0.1:5690"
#
# # Frontend node address (used in both embedded and external modes)
# frontend_addr = "127.0.0.1:4566"
#
# # --- Embedded Mode Configuration ---
# # (Only used when embedded = true)
#
# # Path to the engine binary (auto-discovers if not set)
# # Search order: RISINGWAVE_BIN env var → bin/risingwave-embedded → system PATH
# # binary_path = "/path/to/engine"
#
# # Data directory for the embedded engine
# data_dir = "./nexora-data/event-streaming"
#
# # Startup timeout in seconds
# startup_timeout_secs = 60
#
# # Shutdown timeout in seconds
# shutdown_timeout_secs = 30
#
# # Compute node parallelism (defaults to number of CPU cores)
# # Higher values = more parallelism but more memory usage
# # parallelism = 4
#
# # --- Distributed Library Mode Configuration (Phase 2) ---
# # (Requires --features library)
# #
# # Distributed library mode runs a multi-node cluster where each Nexora process
# # embeds Meta + Frontend + Compute nodes in-process. This provides high
# # availability and horizontal scaling without external binaries.
# #
# # Minimum 3 nodes recommended for production (tolerates 1 node failure).
#
# [event_streaming.distributed]
# # Enable distributed library mode
# enabled = false
#
# # Node identifier (must be unique across cluster)
# # Recommended naming: "meta-1", "meta-2", "meta-3" for a 3-node cluster
# node_id = "meta-1"
#
# # Data directory for persistent storage (Hummock metadata cache)
# data_dir = "./nexora-data/event-streaming-distributed"
#
# # --- Meta Node Configuration ---
# [event_streaming.distributed.meta]
# # Address to bind Meta service (use 0.0.0.0 for all interfaces)
# listen_addr = "0.0.0.0:5690"
#
# # Address other nodes use to reach this Meta node
# # Should be a reachable hostname or IP
# # Example: "node1.local:5690" or "10.0.1.10:5690"
# advertise_addr = "node1.local:5690"
#
# # Peer Meta nodes for Raft cluster formation
# # Format: "node_id@advertise_addr"
# # Do NOT include this node's own ID
# raft_peers = [
#     "meta-2@node2.local:5690",
#     "meta-3@node3.local:5690",
# ]
#
# # Meta backend storage: "etcd", "sqlite", or "memory"
# # - "etcd": Recommended for production (requires external etcd cluster)
# # - "sqlite": Single-node or development (local SQLite file)
# # - "memory": Testing only (all state lost on restart)
# backend = "sqlite"
#
# # Etcd endpoints (only for backend = "etcd")
# # etcd_endpoints = ["http://etcd1:2379", "http://etcd2:2379", "http://etcd3:2379"]
#
# # SQLite path (only for backend = "sqlite")
# sqlite_path = "./nexora-data/meta-node1.db"
#
# # Raft election timeout in milliseconds (default: 3000)
# # Higher = more stable but slower failover
# election_timeout_ms = 3000
#
# # Raft heartbeat interval in milliseconds (default: 1000)
# # Should be << election_timeout_ms (typically 1/3)
# heartbeat_interval_ms = 1000
#
# # --- Frontend Node Configuration ---
# [event_streaming.distributed.frontend]
# # Address to bind PostgreSQL wire protocol listener
# listen_addr = "0.0.0.0:4566"
#
# # --- Compute Node Configuration ---
# [event_streaming.distributed.compute]
# # Address to bind Compute service
# listen_addr = "0.0.0.0:5688"
#
# # Number of parallel workers (default: number of CPU cores)
# # parallelism = 8
#
# # Internal RPC address (default: use listen_addr)
# # internal_rpc_addr = "0.0.0.0:5689"

